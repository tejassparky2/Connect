# ── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API (used to build URLs for locally stored uploads)
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins ("*" allowed only outside production)
CORS_ORIGINS=*
LOG_LEVEL=info

# ── Database (PostgreSQL 16 + PostGIS 3.4) ───────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mohalla?schema=public

# ── JWT (min 32 chars each; generate with: openssl rand -hex 48) ──
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── OTP / Auth provider ──────────────────────────────
#   dev      → OTP generated locally, logged + returned in response (NEVER allowed in production)
#   supabase → Supabase Auth phone OTP (configure Twilio/Textlocal/MSG91 hook in Supabase)
OTP_PROVIDER=dev
OTP_SECRET=dev-otp-hmac-secret-change-me-dev-otp-hmac-secret
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Uploads ─────────────────────────────────────────
# local → stored on disk under ./uploads and served from /uploads (single-node only)
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads

# ── Payments (Razorpay) — wallet top-ups for ads ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Push (Expo) ─────────────────────────────────────
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=false
